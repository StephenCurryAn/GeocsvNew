{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeoCSV Analysis Protocol v1",
  "$defs": {
    "OperatorRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "Operator": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "executor": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "geometryTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "geometryTypes"
            ],
            "additionalProperties": false
          }
        },
        "parameterSchema": {
          "type": "string"
        },
        "output": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string"
            },
            "schemaVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "format",
            "schemaVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "executor",
        "inputs",
        "parameterSchema",
        "output"
      ],
      "additionalProperties": false
    },
    "AnalysisSpec": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "operatorVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "operatorVersion"
      ],
      "additionalProperties": true
    },
    "SpatialPivotSpec": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "spatial_pivot"
        },
        "operatorVersion": {
          "const": 1
        },
        "target": {
          "type": "object",
          "properties": {
            "fileId": {
              "type": "string",
              "maxLength": 255,
              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
            },
            "labelField": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "fileId"
          ],
          "additionalProperties": false
        },
        "join": {
          "type": "object",
          "properties": {
            "fileId": {
              "type": "string",
              "maxLength": 255,
              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
            },
            "categoryField": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "fileId"
          ],
          "additionalProperties": false
        },
        "boundaryPolicy": {
          "enum": [
            "include",
            "exclude"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "operatorVersion",
        "target",
        "join",
        "boundaryPolicy"
      ],
      "additionalProperties": false
    },
    "MoranLisaSpec": {
      "type": "object",
      "title": "Moran/LISA 空间自相关",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "spatial_autocorrelation"
        },
        "operatorVersion": {
          "const": 2
        },
        "target": {
          "type": "object",
          "properties": {
            "fileId": {
              "title": "面图层",
              "type": "string",
              "maxLength": 50,
              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
            },
            "valueField": {
              "title": "分析字段",
              "type": "string",
              "maxLength": 255,
              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
            }
          },
          "required": [
            "fileId",
            "valueField"
          ],
          "additionalProperties": false
        },
        "contiguity": {
          "title": "邻接规则",
          "oneOf": [
            {
              "const": "queen",
              "title": "Queen（共边或共点）"
            },
            {
              "const": "rook",
              "title": "Rook（共边）"
            }
          ],
          "default": "queen"
        },
        "permutations": {
          "title": "置换次数",
          "type": "integer",
          "minimum": 0,
          "maximum": 9999,
          "default": 199
        },
        "seed": {
          "title": "随机种子",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 42
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "operatorVersion",
        "target"
      ],
      "additionalProperties": false
    },
    "DatasetVersion": {
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "fileId",
        "count",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "InputVersions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DatasetVersion"
      }
    },
    "CreatePlan": {
      "type": "object",
      "properties": {
        "spec": {
          "$ref": "#/$defs/AnalysisSpec"
        }
      },
      "required": [
        "spec"
      ],
      "additionalProperties": false
    },
    "Plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "operator": {
          "$ref": "#/$defs/OperatorRef"
        },
        "spec": {
          "$ref": "#/$defs/AnalysisSpec"
        },
        "specHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputVersions": {
          "$ref": "#/$defs/InputVersions"
        },
        "status": {
          "enum": [
            "validated",
            "confirmed"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "confirmedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "operator",
        "spec",
        "specHash",
        "inputVersions",
        "status",
        "createdAt",
        "confirmedAt"
      ],
      "additionalProperties": false
    },
    "ConfirmPlan": {
      "type": "object",
      "properties": {
        "planId": {
          "type": "string",
          "format": "uuid"
        },
        "planVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "planId",
        "planVersion"
      ],
      "additionalProperties": false
    },
    "SubmitRun": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "spec": {
              "$ref": "#/$defs/AnalysisSpec"
            }
          },
          "required": [
            "spec"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/ConfirmPlan"
        }
      ]
    },
    "ErrorCode": {
      "enum": [
        "INVALID_REQUEST",
        "INVALID_SPEC",
        "UNSUPPORTED_OPERATOR",
        "DATASET_NOT_FOUND",
        "UNKNOWN_FIELD",
        "INVALID_GEOMETRY",
        "IDEMPOTENCY_KEY_CONFLICT",
        "PLAN_NOT_FOUND",
        "PLAN_VERSION_CONFLICT",
        "INPUT_VERSION_CHANGED",
        "INPUT_SNAPSHOT_EXPIRED",
        "EXECUTION_TIMEOUT",
        "WORKER_INTERRUPTED",
        "EXECUTION_FAILED"
      ]
    },
    "Run": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "definitionId": {
          "type": "string",
          "format": "uuid"
        },
        "planId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operator": {
          "$ref": "#/$defs/OperatorRef"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "spec": {
          "$ref": "#/$defs/AnalysisSpec"
        },
        "inputVersions": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputVersions"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifactId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "definitionId",
        "planId",
        "operator",
        "status",
        "spec",
        "inputVersions",
        "artifactId",
        "error",
        "errorCode",
        "createdAt",
        "completedAt"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/OperatorRef"
        },
        "spec": {
          "$ref": "#/$defs/AnalysisSpec"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "totalRows": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "runId",
        "schemaVersion",
        "format",
        "operator",
        "spec",
        "columns",
        "totalRows",
        "summary"
      ],
      "additionalProperties": false
    },
    "SpatialCountsRow": {
      "type": "object",
      "properties": {
        "featureId": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "featureId",
        "label",
        "counts",
        "total"
      ],
      "additionalProperties": false
    },
    "SpatialCountsPage": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpatialCountsRow"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "rows",
        "total",
        "page",
        "pageSize"
      ],
      "additionalProperties": false
    },
    "MoranLisaRow": {
      "type": "object",
      "properties": {
        "featureId": {
          "type": "integer"
        },
        "localI": {
          "type": "number"
        },
        "expectedI": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "lagZ": {
          "type": "number"
        },
        "neighborCount": {
          "type": "integer",
          "minimum": 0
        },
        "pValue": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "quadrant": {
          "enum": [
            "HH",
            "HL",
            "LH",
            "LL",
            null
          ]
        }
      },
      "required": [
        "featureId",
        "localI",
        "expectedI",
        "z",
        "lagZ",
        "neighborCount",
        "pValue",
        "quadrant"
      ],
      "additionalProperties": false
    },
    "MoranLisaSummary": {
      "type": "object",
      "properties": {
        "algorithmVersion": {
          "const": "moran-lisa/2.0.0"
        },
        "dependencyLockDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "globalI": {
          "type": "number"
        },
        "expectedI": {
          "type": "number"
        },
        "pValue": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "s0": {
          "type": "integer",
          "minimum": 1
        },
        "excludedValueIds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "crs": {
          "const": "EPSG:4326"
        },
        "valueField": {
          "title": "分析字段",
          "type": "string",
          "maxLength": 255,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]+$"
        },
        "contiguity": {
          "enum": [
            "queen",
            "rook"
          ]
        },
        "permutations": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "algorithmVersion",
        "dependencyLockDigest",
        "executionId",
        "inputDigest",
        "globalI",
        "expectedI",
        "pValue",
        "s0",
        "excludedValueIds",
        "crs",
        "valueField",
        "contiguity",
        "permutations",
        "seed"
      ],
      "additionalProperties": false
    },
    "MoranLisaPage": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoranLisaRow"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "rows",
        "total",
        "page",
        "pageSize"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "message": {
          "type": "string"
        },
        "errorCode": {
          "$ref": "#/$defs/ErrorCode"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Operator"
    },
    {
      "$ref": "#/$defs/CreatePlan"
    },
    {
      "$ref": "#/$defs/Plan"
    },
    {
      "$ref": "#/$defs/SubmitRun"
    },
    {
      "$ref": "#/$defs/Run"
    },
    {
      "$ref": "#/$defs/Artifact"
    },
    {
      "$ref": "#/$defs/SpatialCountsPage"
    },
    {
      "$ref": "#/$defs/MoranLisaPage"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ]
}
