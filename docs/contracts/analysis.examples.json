{
  "Operator": {
    "id": "spatial_pivot",
    "version": 1,
    "name": "行政区内分类 POI 统计",
    "description": "统计每个目标面内的点数，可按点字段分类和指定面标识字段。重叠面分别计数，保留零计数目标。仅支持面内点计数，支持沿用同一算子的历史边界规则。",
    "aliases": ["空间透视", "面内点计数", "面内点统计"],
    "executor": "postgis",
    "inputs": {
      "target": {
        "geometryTypes": [
          "ST_Polygon",
          "ST_MultiPolygon"
        ],
        "fields": { "labelField": { "type": "any", "required": false, "description": "目标面的标识字段" } }
      },
      "join": {
        "geometryTypes": [
          "ST_Point",
          "ST_MultiPoint"
        ],
        "fields": { "categoryField": { "type": "any", "required": false, "description": "点分类字段" } }
      }
    },
    "parameterSchema": "#/$defs/SpatialPivotSpec",
    "planningParameters": {
      "type": "object",
      "properties": {
        "boundaryPolicy": { "type": "string", "description": "是否计入边界点。exclude 排除，include 纳入", "enum": ["exclude", "include"], "default": "exclude" },
        "chartType": { "type": "string", "description": "柱状图、折线图或饼图", "enum": ["bar", "line", "pie"], "default": "bar" }
      },
      "additionalProperties": false
    },
    "output": {
      "format": "spatial_counts",
      "schemaVersion": 1
    }
  },
  "SpatialPivotSpec": {
    "schemaVersion": 1,
    "kind": "spatial_pivot",
