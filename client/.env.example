# Optional API base URL. Defaults to /api and uses the Vite /api proxy in development.
VITE_API_BASE_URL=/api

# Protomaps hosted vector styles (light/white/grayscale/dark/black).
# VITE_* values are visible in the browser. Never put a model API secret here.
VITE_PROTOMAPS_API_KEY=
# TianDiTu uses server/.env TIANDITU_SERVER_KEY. No browser-side TianDiTu key.
