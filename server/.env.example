# Optional; leave DATABASE_URL unset to use PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE.
DATABASE_URL=postgresql://geocsv:geocsv@127.0.0.1:5432/geocsv
PORT=3000
PYTHON_API_URL=http://127.0.0.1:8000/api

# Optional server-side key for configuring, testing, and publishing professional models.
# GEOCSV_MODEL_ADMIN_TOKEN=

# Optional overrides for unified Python runs. Default to the repository Python venv and a local spool.
# ANALYSIS_PYTHON=/absolute/path/to/python
# ANALYSIS_WORKER_DIR=/absolute/path/to/persistent/private/worker-spool

# TianDiTu server-side key for the local basemap proxy. Never use VITE_* for this key.
TIANDITU_SERVER_KEY=
# Optional outbound HTTP proxy and DNS-over-HTTPS resolver for TianDiTu only.
# TIANDITU_PROXY_URL=http://127.0.0.1:7897
# TIANDITU_DOH_URL=https://cloudflare-dns.com/dns-query

# Only needed for the existing AI assistant. Deterministic analyses do not require a key.
ALIYUN_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PLANNER_MODEL=deepseek-v3
# DeepSeek official API for the natural-language operator planner:
# Keep the legacy ALIYUN_API_KEY variable name and supply your DeepSeek key.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_PLANNER_MODEL=deepseek-flash
# Legacy experimental flows still hardcode deepseek-v3; these overrides cover the planner.
# LLM_PROXY_URL=http://127.0.0.1:33210

# Optional private FastAPI planner. Use the same high-entropy token on both services.
# AGENT_SERVICE_URL=http://127.0.0.1:8100
# AGENT_SERVICE_TOKEN=
